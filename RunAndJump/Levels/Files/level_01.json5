// Уровень 1 — вводный. Формат описан в `LevelFile.swift`: тайлы, нижний-левый
// угол, `y` вверх; объект ставится на местную поверхность — у пола это y = 1,
// на ступенях холма y = 2 и y = 3.
{
  "format": 1,
  "name": "Level 1",
  "style": "grassland",
  "size": [45, 16],
  "player": [1, 1],
  "portal": [42, 1],

  // Рельеф. Затеи слева направо:
  //
  // - холм в две ступени (x 9…17): подъём по тайлу за раз, спуск свободным
  //   падением. Заодно делает достижимой площадку на y = 5: с земли до неё
  //   четыре тайла, с вершины холма — два;
  // - проходимый холм (x 28…31, знак `+`): держит только сверху. Мимо него
  //   идут прямо сквозь — по земле там бегает бес, перед ним стоят куст с
  //   деревом и флаг, — а сверху по нему уходят на площадку y = 5;
  // - полка в одну клетку (x 33): ступенька к площадке на y = 5, с которой
  //   начинается верхний маршрут;
  // - парящий остров (x 36…39): проход под ним по земле и награда сверху. Его
  //   низ — потолок: прыгать под ним некуда.
  //
  // Карта ниже уровня: всё выше первой строки — пусто.
  "terrain": [
    "....................................####.....",
    "....................................####.....",
    ".............................................",
    ".............#####..........++++.#...........",
    ".........#########..........++++.............",
    "#############################################",
  ],

  // Пологие холмы, горы лишь мелькают вдалеке.
  "background": {
    "horizonLine": 5,
    "horizon": { "segments": ["hills", "fill", "mountains", "fill"], "width": 8 },
    "sky": { "segments": ["clouds"], "width": 12 },
  },

  // Толщина платформы 0.25 тайла, поэтому y угла = высота верха − 0.25.
  "platforms": [
    { "at": [5, 2.75], "size": [3, 0.25] },
    { "at": [13, 4.75], "size": [3, 0.25] },
    { "at": [24, 2.75], "size": [3, 0.25] },
    { "at": [32, 4.75], "size": [3, 0.25] },
  ],

  "movingPlatforms": [
    // Горизонтальный мост над серединой уровня (верх на y = 4).
    {
      "from": [18, 3.75], "to": [22, 3.75], "size": [3, 0.25], "speed": 90,
      "stops": [{ "progress": 0, "duration": 0.6 }, { "progress": 1, "duration": 0.6 }],
    },
  ],

  // Лестница от земли (y = 1) до первой платформы (верх y = 3).
  "ladders": [
    { "at": [4.5, 1], "height": 2.25 },
  ],

  // Озеро на ровном месте: два тайла — перепрыгивается с разбега.
  "hazards": [
    { "kind": "water", "at": [23, 0], "size": [2, 1] },
  ],

  "enemies": [
    // Растение — на первой ступени холма (поверхность y = 2).
    { "kind": "plant", "at": [10, 2] },
    // Краб ходит по вершине холма (y = 3). Диапазон уже самой вершины
    // (x 13…18): враг шириной 0.75 тайла, и с rightX = 16 он не свешивается
    // с обрыва.
    { "kind": "crab", "at": [15, 3], "patrol": { "leftX": 13, "rightX": 16, "speed": 100 } },
    { "kind": "imp", "at": [28, 1], "patrol": { "leftX": 26, "rightX": 30, "speed": 120 } },
    // Оса висит над землёй: под ней можно пройти, но не перепрыгнуть.
    { "kind": "wasp", "at": [38, 2.5] },
  ],

  "pickups": [
    { "kind": "health", "at": [7, 3.25] },
    { "kind": "coin.bronze", "at": [9, 2.25] },
    { "kind": "coin.silver", "at": [20, 1.25] },
    { "kind": "coin.gold", "at": [30, 1.25] },
    // Аптечка на острове: верхний маршрут должен что-то давать.
    { "kind": "health", "at": [37, 6.25] },
  ],

  // Перед растением, за крабом и после беса — каждая точка закрывает участок,
  // на котором легко погибнуть. Порядок в списке — идентификатор точки в
  // сохранении: новый флаг дописывается в конец, а не вставляется в середину.
  "checkpoints": [
    { "at": [8, 1] },
    { "at": [19, 1] },
    { "at": [31, 1] },
  ],

  // Каждая — на своей поверхности: у пола y = 1, на ступенях холма y = 2 и 3.
  "decorations": [
    { "id": "arrow_right", "at": [3, 1] },
    { "id": "flower_yellow", "at": [7, 1] },
    { "id": "tree_dark", "at": [12, 2] },
    { "id": "tree_light_tall", "at": [13, 3] },
    { "id": "bush_dark_big", "at": [14, 3] },
    { "id": "flower_white", "at": [15, 5] },
    { "id": "flower_pink", "at": [21, 1] },
    { "id": "grass_dark_short", "at": [22, 1] },
    { "id": "flower_purple", "at": [27, 1] },
    { "id": "tree_light_tall", "at": [28, 1] },
    { "id": "grass_dark_tall", "at": [29, 1] },
    { "id": "flower_yellow", "at": [34, 1] },
    { "id": "flower_white", "at": [41, 1] },
  ],
}
